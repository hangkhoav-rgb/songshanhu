{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:map": "playwright test ./scripts/gaode-map.spec.ts",
    "test:e2e": "playwright test ./scripts",
    "test:like-collect": "playwright test ./scripts/like-collect.e2e.spec.ts",
    "test:ui": "playwright test ./scripts/ui-actions-nav-acceptance.spec.ts",
    "report:dark-palette": "node ./scripts/dark-mode-palette-report.mjs",
    "shots:dark": "playwright test ./scripts/dark-mode-screenshots.spec.ts",
    "perf:like-collect": "playwright test ./scripts/like-collect-perf.spec.ts",
    "proto:like-collect": "playwright test ./scripts/like-collect-prototype.spec.ts",
    "test:visual": "playwright test ./scripts/visual-regression.spec.ts",
    "lighthouse:dashboard": "node ./scripts/run-lighthouse-dashboard.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "format": "prettier -w \"src/**/*.{ts,vue,scss,css,md}\"",
    "prepare": "husky install ../.husky"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint"
    ],
    "src/**/*.{ts,vue,scss,css,md}": [
      "prettier -w"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/dompurify": "^3.0.5",
    "@vueup/vue-quill": "^1.2.0",
    "axios": "^1.14.0",
    "dompurify": "^3.3.3",
    "echarts": "^5.4.3",
    "element-plus": "^2.13.6",
    "pinia": "^3.0.4",
    "quill": "^1.3.7",
    "sass": "^1.98.0",
    "vue": "^3.5.30",
    "vue-grid-layout-v3": "^3.1.2",
    "@yeger/vue-masonry-wall": "^5.1.4",
    "vue-quill": "^1.5.1",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "chrome-launcher": "^1.2.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lighthouse": "^12.8.2",
    "lint-staged": "^16.2.5",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.5"
  }
}
